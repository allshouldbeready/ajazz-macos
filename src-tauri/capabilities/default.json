{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for AK820 Pro",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "global-shortcut:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.giphy.com/**" },
        { "url": "https://*.giphy.com/**" },
        { "url": "https://tenor.googleapis.com/**" },
        { "url": "https://*.tenor.com/**" }
      ]
    }
  ]
}
